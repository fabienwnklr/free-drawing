{
  "name": "@fabwcie/free-drawing",
  "author": "Winkler Fabien <fabienwinkler@outlook.fr>",
  "description": "Infinite canvas whiteboard: shapes, freehand drawing, texts, sticky notes, frames, exports and live collaboration (TypeScript, Konva)",
  "contributors": [],
  "private": false,
  "version": "8.2.5",
  "type": "module",
  "main": "./dist/drawer.umd.cjs",
  "module": "./dist/drawer.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=5.7.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/drawer.js",
      "require": "./dist/drawer.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabienwnklr/free-drawing.git",
    "directory": "packages/free-drawing"
  },
  "keywords": [
    "whiteboard",
    "infinite-canvas",
    "canvas",
    "drawing",
    "sketch",
    "diagram",
    "collaboration",
    "konva",
    "typescript"
  ],
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "build:watch": "tsc && vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest dev",
    "lint": "eslint src tests && prettier --check \"src/**/*.{ts,scss}\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit -p . && tsc -p tests",
    "format": "prettier --write \"src/**/*.{ts,scss}\" \"tests/**/*.ts\"",
    "doc:typedoc": "typedoc",
    "release": "git push --follow-tags origin master"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@free-drawing/protocol": "*",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^20.8.7",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.13.0",
    "jest-canvas-mock": "^2.5.2",
    "jsdom": "^29.1.1",
    "konva": "^10.9.0",
    "sass": "^1.106.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "konva": "^10.9.0"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.0",
    "socket.io-client": "^4.7.5",
    "uqr": "^0.1.3"
  }
}
