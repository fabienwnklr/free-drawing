{
  "name": "@fabwcie/free-drawing",
  "author": "Winkler Fabien <fabienwinkler@outlook.fr>",
  "description": "Infinite canvas",
  "contributors": [],
  "private": false,
  "version": "7.9.2",
  "type": "module",
  "main": "./dist/drawer.umd.cjs",
  "module": "./dist/drawer.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=5.7.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/drawer.js",
      "require": "./dist/drawer.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabienwnklr/free-drawing.git",
    "directory": "packages/free-drawing"
  },
  "keywords": [
    "typescript"
  ],
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "build:watch": "tsc && vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest dev",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit -p . && tsc -p tests",
    "format": "prettier src/**/*.ts --write",
    "doc:typedoc": "typedoc --options typedoc.json src/**/*.ts",
    "release": "git push --follow-tags origin master"
  },
  "devDependencies": {
    "@free-drawing/protocol": "*",
    "@types/node": "^20.8.7",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "eslint": "^8.51.0",
    "jest-canvas-mock": "^2.5.2",
    "jsdom": "^22.1.0",
    "konva": "^10.9.0",
    "sass": "^1.69.1",
    "typedoc": "^0.25.2",
    "typedoc-plugin-markdown": "^4.0.0-next.55",
    "typescript": "^5.9.3",
    "vite": "^4.4.5",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^0.34.6"
  },
  "peerDependencies": {
    "konva": "^10.9.0"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.0",
    "socket.io-client": "^4.7.5",
    "uqr": "^0.1.3"
  }
}
