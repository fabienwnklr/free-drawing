{
  "name": "@fabwcie/free-drawing-element",
  "description": "Web component <free-drawing> of free-drawing, infinite canvas drawing board: any page, Angular, Svelte...",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Winkler Fabien <fabienwinkler@outlook.fr>",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabienwnklr/free-drawing.git",
    "directory": "packages/element"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "free-drawing",
    "web-component",
    "custom-element",
    "angular",
    "svelte",
    "drawing",
    "whiteboard",
    "canvas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "lint": "prettier --check \"*.{json,md}\" \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"*.{json,md}\" \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "peerDependencies": {
    "@fabwcie/free-drawing": "^7.29.0 || ^8.0.0"
  }
}
