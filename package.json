{
  "name": "free-drawing-monorepo",
  "description": "free-drawing library, its demo and collaboration server",
  "author": "Winkler Fabien <fabienwinkler@outlook.fr>",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky install",
    "dev": "yarn workspace @free-drawing/web dev",
    "serve": "yarn workspace @free-drawing/server dev",
    "build": "yarn workspace @fabwcie/free-drawing build",
    "build:watch": "yarn workspace @fabwcie/free-drawing build:watch",
    "build:static": "yarn workspace @free-drawing/web build",
    "preview": "yarn workspace @free-drawing/web preview",
    "test": "yarn workspace @fabwcie/free-drawing test && yarn workspace @free-drawing/server test",
    "test:watch": "yarn workspace @fabwcie/free-drawing test:watch",
    "lint": "yarn workspace @fabwcie/free-drawing lint",
    "typecheck": "yarn workspace @fabwcie/free-drawing typecheck && yarn workspace @free-drawing/server typecheck && yarn workspace @free-drawing/web typecheck",
    "format": "yarn workspace @fabwcie/free-drawing format",
    "release": "yarn workspace @fabwcie/free-drawing release",
    "doc:typedoc": "yarn workspace @fabwcie/free-drawing doc:typedoc",
    "doc:changelog": "cp packages/free-drawing/CHANGELOG.md docs/changelog.md",
    "doc:get-started": "cp packages/free-drawing/README.md docs/get-started/index.md",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy:static": "sh script/deploy_static.sh",
    "deploy:doc": "sh script/deploy_doc.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.2",
    "@commitlint/config-conventional": "^17.7.0",
    "@playwright/test": "^1.39.0",
    "commit-and-tag-version": "^11.3.0",
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "prettier": "^3.0.3",
    "typescript": "^5.9.3",
    "vite-svg-loader": "^5.1.0",
    "vitepress": "^1.0.0-rc.42"
  }
}
