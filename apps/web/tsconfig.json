{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "useDefineForClassFields": true,
    /* library sources, as in vite.config.ts */
    "paths": {
      "@fabwcie/free-drawing-extra-tools": ["../../packages/extra-tools/src/index.ts"],
      "@fabwcie/free-drawing": ["../../packages/free-drawing/src/index.ts"],
      "@/*": ["../../packages/free-drawing/src/*"]
    }
  },
  "include": ["src"]
}
